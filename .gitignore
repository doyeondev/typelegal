# =======================================
# 🌐 TypeLegal Monorepo Git Ignore
# Backend (Spring Boot), Frontend (Next.js), Docker, Test 환경 반영
# =======================================

# === 환경 변수 ===
.env*
!.env.example
frontend/.env*
!frontend/.env.example
backend/.env*
!backend/.env.example

# === 의존성 ===
node_modules/
frontend/node_modules/
backend/node_modules/

# === 빌드 결과물 (Frontend) ===
.next/
frontend/.next/
frontend/out/
frontend/build/
frontend/.swc/
.next/cache
.next/static

# === 빌드 결과물 (Backend) ===
target/
backend/target/
*.jar
*.war
*.class
*.ear
build/

# === 캐시/로컬 테스트 결과 ===
.cache/
coverage/
frontend/coverage/
tests/e2e-results/
tests/playwright-report/
tests/test-results/
test-output/
.coverage/

# === 로그 ===
*.log
logfile
mvn-output.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# === IDE 및 시스템 설정 ===
.vscode/
.idea/
*.swp
*.swo
*.sublime-workspace
.project
.classpath
.settings/
.springBeans
.sts4-cache/
nbproject/
nbactions.xml
nb-configuration.xml
*.iml
.DS_Store
Thumbs.db

# === Docker & 배포 ===
docker-compose.override.yml
docker-compose.yml~
docker-compose-debug.yml
Dockerfile~
dockerfile~
.dockerignore

# === Vercel / Preview 시스템 ===
.vercel

# === TypeScript ===
*.tsbuildinfo
next-env.d.ts
.next/
