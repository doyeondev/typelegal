# .env.example

# 운영 환경에서는 사용하실 수 없습니다.
# 이 파일은 구조 이해 및 개발용 설정 예시만 제공합니다.

# Notion API 설정 (콘텐츠 관리용)
NEXT_PUBLIC_NOTION_TOKEN=""
NEXT_PUBLIC_NOTION_DATABASE_ID=""

# SendGrid 이메일 서비스 설정
NEXT_PUBLIC_SENDGRID_API_KEY=""

# Google Analytics 설정
NEXT_PUBLIC_GOOGLE_ANALYTICS=""

# 백엔드 API 엔드포인트
NEXT_PUBLIC_API_URL="http://localhost:8082/api"

# 배포 환경 설정 (development, production, test)
NODE_ENV="development"

# 인증 관련 설정
NEXT_PUBLIC_JWT_SECRET=""  # JWT 검증용 시크릿 키
NEXTAUTH_URL="http://localhost:3000"  # NextAuth.js 인증 URL

# 소셜 로그인 설정 (선택사항)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
NEXT_PUBLIC_GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_KAKAO_CLIENT_ID=""